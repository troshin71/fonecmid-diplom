#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВКМ_Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ВКМ_Период) Тогда
		ПоказатьПредупреждение(, "Выберите период (месяц)!");
		Возврат;
	КонецЕсли;
	
	ВКМ_ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_Создать(Команда)
	
	Если Объект.ВКМ_СписокДоговоров.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Список договоров пуст.");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапуска = ПодготовитьДанныеДляФона();
	
	ДлительнаяОперация = ЗапуститьФоновоеЗаданиеНаСервере(ПараметрыЗапуска);
	
	ПараметрыОжидания = Новый Структура;
	

	ПараметрыОжидания.Вставить("ФормаВладелец", ЭтотОбъект);
	ПараметрыОжидания.Вставить("ТекстСообщения", "Создание документов...");
	ПараметрыОжидания.Вставить("Заголовок", "Пожалуйста, подождите");
	ПараметрыОжидания.Вставить("Картинка", Неопределено);
	ПараметрыОжидания.Вставить("Интервал", 1);
	ПараметрыОжидания.Вставить("ВыводитьОкноОжидания", Истина);
	ПараметрыОжидания.Вставить("ВыводитьПрогрессВыполнения", Истина);
	ПараметрыОжидания.Вставить("ВыводитьСообщения", Истина);
	ПараметрыОжидания.Вставить("ПолучатьРезультат", Истина);
	ПараметрыОжидания.Вставить("ОповещениеОПрогрессеВыполнения", Неопределено);
	НастройкиОповещения = Новый Структура;
	НастройкиОповещения.Вставить("Показать", Истина); 
	НастройкиОповещения.Вставить("Текст", "Обработка завершена");
	НастройкиОповещения.Вставить("НавигационнаяСсылка", Неопределено);
	НастройкиОповещения.Вставить("Пояснение", "");
	НастройкиОповещения.Вставить("Важное", Ложь);
	НастройкиОповещения.Вставить("Картинка", Неопределено);
	НастройкиОповещения.Вставить("ИмяФормы", Неопределено);
	НастройкиОповещения.Вставить("ИмяКоманды", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыКоманды", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыОповещения", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыФормы", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыКомандыФормы", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыОповещенияФормы", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыОповещенияКоманды", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыОповещенияКомандыФормы", Неопределено);
	НастройкиОповещения.Вставить("ПараметрыОповещенияКомандыФормы", Неопределено);
	
	ПараметрыОжидания.Вставить("ОповещениеПользователя", НастройкиОповещения);

	
	Оповещение = Новый ОписаниеОповещения("ВКМ_СоздатьЗавершение", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьФоновоеЗаданиеНаСервере(ПараметрыЗапуска)
	
Метод = "ВКМ_ФоновыеЗадания.ВыполнитьСозданиеАктов";

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Создание актов (ВКМ)";
	ПараметрыВыполнения.КлючФоновогоЗадания = "СозданиеАктов_" + Строка(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(Метод, ПараметрыЗапуска, ПараметрыВыполнения);
	
КонецФункции



&НаКлиенте
Процедура ВКМ_СоздатьЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат; 
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ОтветСервера = ПолучитьРезультатИзХранилища(Результат.АдресРезультата);
		
		ТекстСообщения = "Обработка завершена." + Символы.ПС + 
						 "Создано документов: " + ОтветСервера.СозданоДокументов;
		
		Если ОтветСервера.Ошибки.Количество() > 0 Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + "Были ошибки (см. журнал регистрации).";
		КонецЕсли;
		
		ПоказатьПредупреждение(, ТекстСообщения);
		
		ВКМ_ЗаполнитьНаСервере();
		
	Иначе
		ПоказатьПредупреждение(, "Ошибка фонового задания: " + Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьДанныеДляФона()
	
ДанныеДляОбработки = Новый Массив;
	
	Для Каждого Строка ИЗ Объект.ВКМ_СписокДоговоров Цикл
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("Договор", Строка.ВКМ_Договор);
		СтруктураСтроки.Вставить("Реализация", Строка.ВКМ_Реализация);
		
		ДанныеДляОбработки.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	ПараметрыЗапуска = Новый Структура; 
	ПараметрыЗапуска.Вставить("Период", Объект.ВКМ_Период);
	ПараметрыЗапуска.Вставить("ДанныеДляОбработки", ДанныеДляОбработки);
	
	Возврат ПараметрыЗапуска;
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатИзХранилища(Адрес)
	Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

&НаСервере
Процедура ВКМ_ЗаполнитьНаСервере()
	
Объект.ВКМ_СписокДоговоров.Очистить();
	
	НачалоМесяца = НачалоМесяца(Объект.ВКМ_Период);
	КонецМесяца  = КонецМесяца(Объект.ВКМ_Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Договор,
		|	ЕСТЬNULL(Реализации.Ссылка, ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)) КАК Реализация
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
		|		ПО Договоры.Ссылка = Реализации.Договор
		|		И Реализации.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|		И НЕ Реализации.ПометкаУдаления
		|ГДЕ
		|	Договоры.ВидДоговора = &ВидДоговора
		|	И НЕ Договоры.ПометкаУдаления
		|	И (Договоры.ВКМ_ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ Договоры.ВКМ_ДатаОкончания >= &НачалоМесяца)";
		
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ВКМ_СписокДоговоров.Добавить();
		НоваяСтрока.ВКМ_Договор = Выборка.Договор;
		НоваяСтрока.ВКМ_Реализация = Выборка.Реализация;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти