#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВКМ_Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ВКМ_Период) Тогда
		ПоказатьПредупреждение(, "Выберите период (месяц)!");
		Возврат;
	КонецЕсли;
	
	ВКМ_ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_Создать(Команда)
	
Если Объект.ВКМ_СписокДоговоров.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Список договоров пуст.");
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполнения = ПодготовитьДанныеДляФона();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Вставить("ТекстОжидания", "Создание документов...");
	ПараметрыОжидания.Вставить("ВыводитьОкноОжидания", Истина);
	ДлительныеОперацииКлиент.ВыполнитьВФоне(
		"Обработка.ВКМ_МассовоеСозданиеАктов.МодульМенеджера.ВыполнитьСозданиеАктов", 
		ПараметрыВыполнения, 
		ПараметрыОжидания, 
		Новый ОписаниеОповещения("ВКМ_СоздатьЗавершение", ЭтотОбъект));
	
КонецПроцедуры


&НаКлиенте
Процедура ВКМ_СоздатьЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат; 
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ОтветСервера = ПолучитьРезультатИзХранилища(Результат.АдресРезультата);
		
		ТекстСообщения = "Обработка завершена." + Символы.ПС + 
						 "Создано документов: " + ОтветСервера.СозданоДокументов;
		
		Если ОтветСервера.Ошибки.Количество() > 0 Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + "Были ошибки (см. журнал регистрации).";
		КонецЕсли;
		
		ПоказатьПредупреждение(, ТекстСообщения);
		
		ВКМ_ЗаполнитьНаСервере();
		
	Иначе
		ПоказатьПредупреждение(, "Ошибка фонового задания: " + Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьДанныеДляФона()
	
ДанныеДляОбработки = Новый Массив;
	
	Для Каждого Строка ИЗ Объект.ВКМ_СписокДоговоров Цикл
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("Договор", Строка.ВКМ_Договор);
		СтруктураСтроки.Вставить("Реализация", Строка.ВКМ_Реализация);
		
		ДанныеДляОбработки.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	ПараметрыЗапуска = Новый Структура; 
	ПараметрыЗапуска.Вставить("Период", Объект.ВКМ_Период);
	ПараметрыЗапуска.Вставить("ДанныеДляОбработки", ДанныеДляОбработки);
	
	Возврат ПараметрыЗапуска;
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатИзХранилища(Адрес)
	Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

&НаСервере
Процедура ВКМ_ЗаполнитьНаСервере()
	
	Объект.ВКМ_СписокДоговоров.Очистить();
	
	НачалоМесяца = НачалоМесяца(Объект.ВКМ_Период);
	КонецМесяца  = КонецМесяца(Объект.ВКМ_Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Договор,
		|	ЕСТЬNULL(Реализации.Ссылка, ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)) КАК Реализация
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
		|		ПО Договоры.Ссылка = Реализации.Договор
		|		И Реализации.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|		И НЕ Реализации.ПометкаУдаления
		|ГДЕ
		|	Договоры.ВидДоговора = &ВидДоговора
		|	И НЕ Договоры.ПометкаУдаления";
		
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ВКМ_СписокДоговоров.Добавить();
		НоваяСтрока.ВКМ_Договор = Выборка.Договор;
		НоваяСтрока.ВКМ_Реализация = Выборка.Реализация;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти